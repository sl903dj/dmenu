#!/bin/sh

# 历史记录保存路径
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
HISTORY_FILE="$CACHE_DIR/dmenu_desktop_history"

# 1. 扫描所有 App Name
ALL_APPS=$(grep -h -m 1 "^Name=" /usr/share/applications/*.desktop ~/.local/share/applications/*.desktop 2>/dev/null | cut -d= -f2- | sort -u)

# 2. 读取历史记录，按使用频率从高到低排序，并与全部 App 组合（去除重复）
if [ -f "$HISTORY_FILE" ]; then
  # 提取按频率排序的历史 App，并滤掉已经卸载的
  SORTED_HISTORY=$(sort "$HISTORY_FILE" | uniq -c | sort -nr | awk '{$1=""; print $0}' | sed 's/^ //')
  # 优先显示历史 App，后面追加未启动过的 App
  APP_LIST=$(printf "%s\n%s" "$SORTED_HISTORY" "$ALL_APPS" | awk '!seen[$0]++')
else
  APP_LIST="$ALL_APPS"
fi

# 3. 传给 dmenu 选择
APP=$(printf "%s\n" "$APP_LIST" | dmenu -i -p "Apps:")

if [ -n "$APP" ]; then
  # 记录本次选择到历史文件
  echo "$APP" >>"$HISTORY_FILE"

  # 4. 找到对应的 .desktop 文件并启动
  DESKTOP_FILE=$(grep -l -m 1 "^Name=$APP" /usr/share/applications/*.desktop ~/.local/share/applications/*.desktop 2>/dev/null | head -n 1)

  if [ -n "$DESKTOP_FILE" ]; then
    DESKTOP_NAME=$(basename "$DESKTOP_FILE")
    if command -v gtk-launch >/dev/null 2>&1; then
      gtk-launch "$DESKTOP_NAME" >/dev/null 2>&1 &
    else
      EXEC=$(grep -m 1 "^Exec=" "$DESKTOP_FILE" | cut -d= -f2- | sed 's/ %[a-zA-Z]//g')
      nohup sh -c "$EXEC" >/dev/null 2>&1 &
      disown
    fi
  fi
fi
